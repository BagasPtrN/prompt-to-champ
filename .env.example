# =========================================================
# PROMPT TO CHAMP — contoh konfigurasi
# Salin file ini menjadi ".env" lalu sesuaikan.
# =========================================================

# Port server (default 3000)
PORT=3000

# Provider gambar: "mock" (placeholder lokal, gratis) atau nama provider lain
# yang adapter-nya sudah tersedia di server/imageProviders/
IMAGE_PROVIDER=mock

# Batas request gambar yang diproses paralel (jaga-jaga rate limit provider)
MAX_PARALLEL=6

# Timeout per gambar (ms) sebelum dianggap gagal lalu di-retry 1x
IMAGE_TIMEOUT_MS=60000

# ---- Contoh kunci provider sungguhan (SIMpan HANYA di server, jangan commit) ----
# Aktifkan dengan: IMAGE_PROVIDER=openai  (setelah rename openai.example.js -> openai.js)
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
